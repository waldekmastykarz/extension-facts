{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extension Performance Facts v1.0",
  "description": "Measured performance of one agent extension version on a fixed eval suite, compared with a baseline per task and agent profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extension",
    "eval",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "version",
        "scope",
        "digest"
      ],
      "properties": {
        "type": {
          "description": "Kind of agent extension. `plugin` is a bundle of other extensions.",
          "enum": [
            "skill",
            "mcp-server",
            "instructions",
            "agent",
            "plugin"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "scope": {
          "description": "One-line summary of what the extension does.",
          "type": "string",
          "minLength": 1,
          "maxLength": 61
        },
        "digest": {
          "description": "SHA-256 identifying the exact extension content that was measured, so tools can detect facts that no longer match. skill and plugin: over the extension folder excluding facts/; for every regular file, sorted by POSIX relative path in byte order, hash the line `<path>\\t<sha256 of file bytes>\\n`. mcp-server: the distributed artifact, such as the package tarball or the OCI image manifest. instructions and agent: the file bytes.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "sha",
        "date",
        "runsPerRow"
      ],
      "properties": {
        "suite": {
          "description": "Identifier or location of the eval suite, for example a repository path at a version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 54
        },
        "sha": {
          "description": "Commit or content hash identifying the exact eval suite.",
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "runsPerRow": {
          "description": "Independent runs behind every configuration row.",
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "description": "Optional per-task evidence, such as eval readouts, kept outside the extension package.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "uri",
              "sha256"
            ],
            "properties": {
              "task": {
                "type": "string",
                "pattern": "^T[1-9][0-9]*$"
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "criteria",
        "profiles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "criteria": {
          "description": "Number of binary criteria each run is graded on.",
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "model",
        "reasoningEffort",
        "platform",
        "rows"
      ],
      "properties": {
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          }
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "reasoningEffort": {
          "description": "Reasoning effort used, or `default` when the harness did not set one.",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/row"
          },
          "contains": {
            "type": "object",
            "required": [
              "baseline"
            ],
            "properties": {
              "baseline": {
                "const": true
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "baseline",
        "score",
        "usage"
      ],
      "properties": {
        "configuration": {
          "description": "`baseline`, the skill under test, or a competing extension, with its version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "baseline": {
          "type": "boolean"
        },
        "score": {
          "description": "Percentage of criteria passed per run: the mean over runsPerRow runs, and the lowest and highest run.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mean",
            "min",
            "max"
          ],
          "properties": {
            "mean": {
              "$ref": "#/$defs/percent"
            },
            "min": {
              "$ref": "#/$defs/percent"
            },
            "max": {
              "$ref": "#/$defs/percent"
            }
          }
        },
        "usage": {
          "description": "Mean per-run usage over runsPerRow runs.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokens",
            "usd"
          ],
          "properties": {
            "tokens": {
              "description": "Input + output tokens, including cached input.",
              "type": "integer",
              "minimum": 0
            },
            "usd": {
              "description": "Cost at list price on the eval date.",
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
